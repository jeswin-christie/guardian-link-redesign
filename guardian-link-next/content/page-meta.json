      "@type": "FAQPage",
      "mainEntity": [
       {
        "@type": "Question",
        "name": "Does My Guardian Link work everywhere?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "My Guardian Link works on cellular data or Wi-Fi. Performance depends on coverage, connectivity, and device connections."
        }
       },
       {
        "@type": "Question",
        "name": "Is this a replacement for 911?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "No. It is designed to support 911 when you cannot call, speak, or explain clearly."
        }
       },
       {
        "@type": "Question",
        "name": "Who receives my signal?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Your trusted contacts and a personal coordinator."
        }
       },
       {
        "@type": "Question",
        "name": "What does the coordinator do?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "A live coordinator reviews your alert in real time, verifies your location and message, and begins the next response steps immediately."
        }
       },
       {
        "@type": "Question",
        "name": "Does it work if I cannot talk?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Yes. The system is designed for silent or limited-action situations."
        }
       },
       {
        "@type": "Question",
        "name": "Is my location sent?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Yes, the system sends GPS location when available."
        }
       },
       {
        "@type": "Question",
        "name": "Can my family be notified?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Yes, trusted contacts can receive the urgent signal."
        }
       },
       {
        "@type": "Question",
        "name": "Is there a record?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Yes. Incident activity can be time-stamped and documented for accountability."
        }
       },
       {
        "@type": "Question",
        "name": "Who should use this?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Anyone who may need help when they cannot speak, move, call, or explain clearly."
        }
       }
      ]
     }
    ]
   }
  ]
 },

     {
      "@type": "FAQPage",
      "mainEntity": [
       {
        "@type": "Question",
        "name": "Why can’t I sign in?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Make sure you are using the email address or mobile number connected to your My Guardian Link account. Confirm that your internet connection is active and that your password was entered correctly. If you still cannot sign in, contact My Guardian Link Support."
        }
       },
       {
        "@type": "Question",
        "name": "Why am I not receiving my verification code?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Verification codes may be delayed by your mobile carrier or email provider. Check the following: Confirm that your phone number or email address is correct. Check your email spam or junk folder. Make sure your phone can receive text messages. Do not request several codes in rapid succession. Only the newest code may work. Contact Support if the code still does not arrive."
        }
       },
       {
        "@type": "Question",
        "name": "Why is Sign in with Apple not working?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Make sure you are signed into your Apple ID on the device and that your internet connection is active. If you previously selected Hide My Email, your My Guardian Link account may be connected to Apple’s private relay email address rather than your regular email address. Try signing in again with Apple. If the problem continues, contact Support and provide the email address you believe is connected to your account."
        }
       },
       {
        "@type": "Question",
        "name": "How do I create an account?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "1. Open the My Guardian Link app. 2. Select Create Account or Get Started. 3. Enter the requested account information. 4. Verify your email address and mobile number. 5. Complete your profile and protection settings. 6. Select a membership plan when prompted. You must accept the Terms of Use and Privacy Policy before completing registration."
        }
       },
       {
        "@type": "Question",
        "name": "How do I add trusted contacts?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "1. Open the My Guardian Link app. 2. Go to Profile or Trusted Contacts. 3. Select Add Trusted Contact. 4. Enter the person’s name, mobile number, and email address. 5. Save the contact and send the invitation if prompted. Trusted contacts should know that you selected them and understand how to respond when they receive an alert. You must accept the Terms of Use and Privacy Policy before completing registration."
        }
       },
       {
        "@type": "Question",
        "name": "How do I test Urgent Assist?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "1. Open Urgent Assist in the app. 2. Follow the activation instructions shown on the screen. 3. Clearly enter or say: “Practice call test only.” 4. Confirm that your trusted contacts and the response workflow operate as expected. Do not use Urgent Assist for casual testing without identifying the activation as a practice test."
        }
       },
       {
        "@type": "Question",
        "name": "How do I manage or cancel a subscription?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Subscriptions purchased through Apple must be managed through your Apple account: 1. Open the iPhone Settings app. 2. Tap your name. 3. Tap Subscriptions. 4. Select My Guardian Link. 5. Choose the available option to manage or cancel the subscription. Deleting the app does not automatically cancel a subscription. Cancellation normally stops future renewal while access continues through the current paid term."
        }
       },
       {
        "@type": "Question",
        "name": "How do I delete my account?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "1. Open the My Guardian Link app. 2. Go to Profile or Account Settings. 3. Select Delete Account. 4. Review the information shown. 5. Confirm the deletion request. Account deletion is permanent and may remove your profile, settings, trusted-contact connections, and other account information. Cancel any active Apple subscription separately through your Apple subscription settings."
        }
       },
       {
        "@type": "Question",
        "name": "How do I fix location or notification issues?",
        "acceptedAnswer": {
         "@type": "Answer",
         "text": "Confirm that My Guardian Link has permission to use location services and send notifications. On iPhone: 1. Open Settings. 2. Select My Guardian Link. 3. Allow Notifications. 4. Open Location and select the location permission recommended by the app. 5. Turn on Precise Location. 6. Confirm that cellular data is enabled for the app. Also make sure Low Power Mode, Focus settings, or restricted background activity are not preventing alerts or location updates. Reopen the app after changing permissions."
        }
       }
      ]
     }
    ]
   }
  ]
